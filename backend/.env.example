# Supply real values through your host's secret settings.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ZeroTrustShare
# 32 random bytes encoded as 64 hex characters. Keep this key stable and backed up.
ENCRYPTION_KEY=replace_with_64_random_hex_characters
# At least 32 random characters; required in production.
JWT_SECRET=replace_with_a_strong_random_secret

# Storage (S3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace_with_your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_your_aws_secret_access_key
AWS_S3_BUCKET_NAME=replace_with_your_bucket_name

# Required in production. Public HTTPS origin, without a trailing slash.
# APP_ORIGIN=https://vault.example.com
# Set only if one trusted reverse proxy sits in front of the app.
# TRUST_PROXY=1
